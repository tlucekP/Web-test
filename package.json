    "@types/react-dom": "^19",
    "autocannon": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "lighthouse": "^12.6.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
